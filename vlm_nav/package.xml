<?xml version="1.0"?>
<package format="3">
  <name>vlm_nav</name>
  <version>0.1.0</version>
  <description>Standalone Python library for VLM navigation</description>

  <maintainer email="takahiro.miki1992@gmail.com">Takahiro Miki</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- runtime deps for ROS2 (optional, since it's mostly a pure Python lib) -->
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
